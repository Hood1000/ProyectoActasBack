# Base de datos y autenticacion
DATABASE_URL="postgresql://usuario:clave@127.0.0.1:5432/actas"
JWT_SECRET="cambia-este-secreto"
PORT=5000
CORS_ORIGINS="http://localhost:5173"
APP_TIMEZONE="America/Caracas"
WORK_HOURS_START=7
WORK_HOURS_END=18
ANNUAL_CLOSE_ENFORCE_READ_ONLY=true

# Correo (opcional)
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_URL=http://localhost:5173

# Alternativa HTTPS: MAIL_TRANSPORT=gmail-api (requiere consentimiento OAuth)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=

# Almacenamiento de archivos (acta firmada)
# Sin GCS_BUCKET los archivos se guardan en ./uploads y se sirven con URL firmada local.
GCS_BUCKET=
GCS_PROJECT_ID=
# Ruta al JSON de la cuenta de servicio; no hace falta si el servidor usa su propia identidad (Cloud Run, GCE).
GOOGLE_APPLICATION_CREDENTIALS=
GCS_SIGNED_URL_TTL_SECONDS=600
UPLOAD_MAX_BYTES=15728640
# URL publica del API, usada para armar las URLs firmadas locales detras de un proxy.
PUBLIC_API_URL=
